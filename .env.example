PORT=3100

PG_PORT=5432
PG_HOST=
PG_USER=
PG_PASSWORD=""
PG_DATABASE=""

JWT_ADMIN_EXPIRE='1h'
JWT_ADMIN_SECRET=''

# Password reset (forgot password email link)
JWT_RESET_SECRET=''
JWT_RESET_EXPIRE='1h'
FRONTEND_URL='http://localhost:3000'
FRONTEND_RESET_PASSWORD_PATH='/reset-password'

# SMTP / Office 365 (optional — if unset, email content is logged server-side only)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_FROM=
SMTP_LOG_ONLY=false

# OAuth2 (recommended for Microsoft 365 — set these instead of SMTP_PASS)
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
SMTP_OAUTH_TENANT_ID=common

# Basic auth fallback (only if OAuth2 vars are not set)
SMTP_PASS=

# Firebase Configuration
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=

ID_ENCODER_SECRET=""